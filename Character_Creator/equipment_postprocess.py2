import os
import re
import json
import argparse
from typing import Dict, List, Tuple, Optional, Set

from Character_Creator.equipment_aggregator import aggregate_equipment
from Character_Creator.gear_pack_selector import suggest_packs_for_character

# -----------------------------------------------------------------------------
# HARD-CODED CSV CANONICAL -> LIBRARY ITEM NAME MAPPINGS
# (Built from your CSV plus the corrected Spray/Seeker libraries you uploaded.)
#
# Keys are LOWERCASE; incoming names are lowercased before lookup.
# -----------------------------------------------------------------------------
CSV_HARDCODED_MAP: Dict[str, str] = {
    "archive": "Portable SolArchive",
    "private server": "Private Server",
    "scout nanoswarm": "Scout Swarm",
    "spy nanoswarm": "Spy Swarm",
    "biometric matcher": "Brainprint Scanner",
    "comfurt": "Comfort",
    "assault rifle railgun": "Assault Rifle",
    "smart hawk": "Smart Hawk",
    "enhanced security": "Enhanced Security",
    "exploit app": "Exploit",
    "spoofer app": "Spoofer",
    "psychosurgery app": "Psychosurgery",
    "simulspace": "Simulspace",
    "microcar": "Microcar",
    "dino pet": "Dino Pet",
    "shredder": "Shredder",  # present in wlibrary_spray.json
}

SECTION_HEADER = "\nEquipment:\n"

# ONLY remove the exact orphan 'Gear Packs:\n  [None]\n\n' if present.
_GEARPACKS_NONE_EXACT = "Gear Packs:\n  [None]\n\n"
def _strip_orphan_none_block(text: str) -> str:
    for _ in range(3):
        text = text.replace(_GEARPACKS_NONE_EXACT, "")
    return text

def _one_line(s: Optional[str]) -> str:
    if s is None:
        return ""
    return re.sub(r"\s+", " ", str(s).replace("\\n", " ").replace("\\t", " ")).strip()

def _desc_from_fields(d: Dict) -> str:
    # Prefer Description; else synthesize from typical stats/notes.
    for key in ("Description","Long","Short","Effects","Bonuses","Use","Usage","Function","Functions","Notes"):
        v = d.get(key)
        if isinstance(v, (str,int,float)) and str(v).strip():
            return _one_line(v)
        if isinstance(v, list) and v:
            return _one_line(", ".join(str(x) for x in v))
    bits = []
    for k in ("Movement","Size","Armor","Complexity/GP","WT","DUR","DR","Rating","Capacity","Damage","Firing Modes","Range","Ammo"):
        if d.get(k):
            bits.append(f"{k.split(' (')[0]} {d[k]}")
    return _one_line("; ".join(bits))

def _collect_library_items(libraries_dir: str) -> Dict[str, Dict]:
    """Load Gear_Library + Weapon_Library JSONs into a dict of Name -> entry (plus _source_file)."""
    details: Dict[str, Dict] = {}

    def ingest_file(path: str):
        try:
            obj = json.load(open(path, "r", encoding="utf-8"))
        except Exception:
            return
        def walk(o):
            if isinstance(o, list):
                for it in o:
                    walk(it)
            elif isinstance(o, dict):
                name = o.get("Name")
                if isinstance(name, str) and name.strip():
                    rec = dict(o)
                    if not _one_line(rec.get("Description")):
                        rec["Description"] = _desc_from_fields(rec)
                    rec.setdefault("_source_file", os.path.basename(path))
                    details[name.strip()] = rec
                for v in o.values():
                    if isinstance(v, (list, dict)):
                        walk(v)
        walk(obj)

    for sub in ("Gear_Library","Weapon_Library"):
        d = os.path.join(libraries_dir, sub)
        if os.path.isdir(d):
            for fn in os.listdir(d):
                if fn.endswith(".json"):
                    ingest_file(os.path.join(d, fn))
    return details

def _resolve_library_name(raw_name: str, details: Dict[str, Dict]) -> str:
    """Resolve a sheet item to an exact library name using ONLY:
       1) Hard-coded CSV mapping (lowercased key)
       2) Exact match fallback
       No fuzzy logic, no guessing.
    """
    if not isinstance(raw_name, str):
        return raw_name
    s = raw_name.strip()
    if not s:
        return s

    key = s.lower()
    # 1) CSV hard map
    mapped = CSV_HARDCODED_MAP.get(key)
    if mapped:
        return mapped if mapped in details else s

    # 2) Exact match (including dose suffixes etc.)
    return s if s in details else s

def _format_item_line(display_name: str, lib: Dict) -> str:
    # Weapon stats?
    if any(k in lib for k in ("Damage","Firing Modes","Ammo","Range")):
        bits = [display_name]
        if lib.get("Damage"): bits.append(f"DV {lib['Damage']}")
        if lib.get("Firing Modes"): bits.append(f"FM {lib['Firing Modes']}")
        if lib.get("Range"): bits.append(f"Rng {lib['Range']}")
        if lib.get("Ammo"): bits.append(f"Ammo {lib['Ammo']}")
        if lib.get("Notes"): bits.append(f"({lib['Notes']})")
        return " — ".join([bits[0], ", ".join(bits[1:])]) if len(bits) > 1 else bits[0]
    # Armor shorthand?
    if "Energy" in lib or "Kinetic" in lib:
        e = lib.get("Energy"); k = lib.get("Kinetic")
        bits = [display_name]
        if e is not None and k is not None:
            bits.append(f"Armor E{e}/K{k}")
        elif e is not None:
            bits.append(f"Armor E{e}")
        elif k is not None:
            bits.append(f"Armor K{k}")
        if lib.get("Notes"): bits.append(f"({lib['Notes']})")
        return " — ".join([bits[0], ", ".join(bits[1:])]) if len(bits) > 1 else bits[0]
    # Generic description
    desc = lib.get("Description")
    return f"{display_name} — {desc}" if desc else display_name

def _build_equipment_block(grouped: Dict[str, List[str]], packs_with_sources: List[Tuple[str,str]], libraries_dir: str) -> str:
    details = _collect_library_items(libraries_dir)
    lines: List[str] = [SECTION_HEADER.strip()]

    packs = [name for (name, _src) in packs_with_sources]
    if packs:
        lines.append("  Gear Packs:")
        for name in packs:
            lines.append(f"    {name}")
        lines.append("")

    # For each category/line from the aggregator, rewrite the item name using the hard map,
    # then print formatted line with library stats/description when available.
    for cat in grouped.keys():
        items = grouped.get(cat) or []
        if not items:
            continue
        lines.append(f"  {cat}:")
        for it in items:
            lib_name = _resolve_library_name(it, details)
            lib = details.get(lib_name, {})
            lines.append(f"    { _format_item_line(lib_name if lib else it, lib) }")
    lines.append("")
    return "\n".join(lines)

def append_equipment_to_txt(txt_path: str, libraries_path: str = "libraries", inplace: bool = True, out_path: Optional[str] = None) -> str:
    # Suggest packs (unchanged behavior)
    suggestions = suggest_packs_for_character(txt_path, libraries_dir=libraries_path)
    selected = {name for (name, _src) in suggestions}

    # Aggregate equipment using your existing helper
    grouped, packs = aggregate_equipment(txt_path, libraries_dir=libraries_path, selected_packs=selected)

    # Build the block (using hard-coded mapping + library details)
    block = _build_equipment_block(grouped, packs, libraries_path)

    # Read existing content and remove only the orphan "[None]" packs block if present
    with open(txt_path, "r", encoding="utf-8") as f:
        original = f.read()
    cleaned = _strip_orphan_none_block(original)

    # Write result
    if inplace:
        with open(txt_path, "w", encoding="utf-8") as f:
            f.write(cleaned.rstrip() + "\n\n" + block)
        return txt_path
    else:
        if not out_path:
            root, ext = os.path.splitext(txt_path)
            out_path = root + "_with_equipment" + ext
        with open(out_path, "w", encoding="utf-8") as dst:
            dst.write(cleaned.rstrip() + "\n\n" + block)
        return out_path

def main():
    ap = argparse.ArgumentParser(description="Append grouped Equipment section to a Muse TXT (CSV-hardcoded mappings)")
    ap.add_argument("txt_path")
    ap.add_argument("--libraries", default="libraries")
    ap.add_argument("--inplace", action="store_true")
    ap.add_argument("--out", default=None)
    args = ap.parse_args()

    result = append_equipment_to_txt(args.txt_path, libraries_path=args.libraries, inplace=args.inplace, out_path=args.out)
    print(result)

if __name__ == "__main__":
    main()
